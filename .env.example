DATABASE_URL=postgresql+asyncpg://soc:soc@localhost:5432/soc_copilot
REDIS_URL=redis://localhost:6379/0

# claude | openai | ollama
LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_EFFORT=low
# OPENAI_MODEL=gpt-4o-mini
# Ollama (no key). docker compose runs its own Ollama; to use one on the host instead,
# set http://host.docker.internal:11434 (from Docker) or http://localhost:11434.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b
# USD per million tokens, used only for the cost column in the eval report
# LLM_PRICE_INPUT_PER_MTOK=2.0
# LLM_PRICE_OUTPUT_PER_MTOK=10.0
