DATABASE_URL=postgresql+asyncpg://soc:soc@localhost:5432/soc_copilot
REDIS_URL=redis://localhost:6379/0

# claude | openai | ollama
LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_EFFORT=low
# OPENAI_MODEL=gpt-4o-mini
# Ollama (no key). docker compose runs its own Ollama; to use one on the host instead,
# set http://host.docker.internal:11434 (from Docker) or http://localhost:11434.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b
# Known assets whose routine work is not evidence of an attack (backup server, CI runner).
# docker compose points it at the synthetic network's inventory; set your own for real logs.
# ASSET_INVENTORY=backend/app/data/synthetic_assets.json
# USD per million tokens, used only for the cost column in the eval report
# LLM_PRICE_INPUT_PER_MTOK=2.0
# LLM_PRICE_OUTPUT_PER_MTOK=10.0

# --- Production (docker-compose.prod.yml) ---
# DOMAIN=soc.example.com            # DNS must point at the server; Caddy gets the certificate
# POSTGRES_PASSWORD=                # letters and digits only, e.g. from: openssl rand -hex 24
# LLM_PROVIDER=claude               # the prod file defaults to claude
# DEMO_MODE=true                    # read-only API; POST /analyze saves nothing and is rate-limited
# DEMO_ANALYSES_PER_IP_PER_HOUR=5
# DEMO_ANALYSES_PER_DAY=200         # global cap on LLM calls per UTC day; also set a spend
#                                   # limit on the API key in the provider's console
# DEMO_MAX_EVENTS=500               # largest batch one /analyze call accepts in demo mode
